:root {
  --green: #79b654;
  --dark-green: #385f35;
  --gold: #ffe1a0;
  --panel: #283b3d;
  --surface: #40554e;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

body {
  background: #142a38;
  color: white;
  font-family: Arial, Helvetica, sans-serif;
  user-select: none;
}

canvas {
  display: block;
  image-rendering: pixelated;
}

[hidden] { display: none !important; }

button {
  background: var(--green);
  color: white;
  padding: 11px 16px;
  border: 2px solid var(--dark-green);
  border-radius: 3px;
  font-weight: 800;
  cursor: pointer;
  box-shadow: inset 0 -3px #355a30;
}

button:hover { filter: brightness(1.12); }
button:disabled { opacity: .4; cursor: default; }

button.danger {
  background: #ab4f4f;
  border-color: #793636;
}

#menu {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 13px;
  padding: 24px;
  overflow-y: auto;
  text-align: center;
  background:
    radial-gradient(circle at 50% 28%, #3b7151, transparent 54%),
    linear-gradient(130deg, #15293c, #203c2e);
}

.brand {
  font-size: 24px;
  font-weight: 900;
  letter-spacing: 7px;
  color: #c9e8ff;
}

#menu h1 {
  margin: 0;
  color: #b2ec90;
  font-size: clamp(34px, 7vw, 75px);
  font-weight: 900;
  text-shadow: 4px 4px #355332, 7px 7px #172d20;
}

#menu h2 {
  margin: 0;
  font-size: 17px;
  letter-spacing: 4px;
  color: var(--gold);
}

#menu p { color: #e0e9dc; }
#menu > button { width: 235px; }

.guide {
  width: min(660px, 96vw);
  padding: 14px;
  background: #07161bd2;
  border: 2px solid #72917e;
}

.guide h3 { color: var(--gold); }

.guide p {
  margin: 6px 0;
  line-height: 1.35;
  font-size: 13px;
}

/* GAME HUD */

#hud {
  position: fixed;
  inset: 0;
  z-index: 5;
  pointer-events: none;
  text-shadow: 1px 2px 3px black;
}

#information,
#status,
#riding {
  position: absolute;
  padding: 10px 12px;
  background: #07140dd9;
  border: 1px solid #d5e6cf66;
  font: 12px/1.65 monospace;
}

#information {
  left: 12px;
  top: 12px;
  min-width: 165px;
}

#information strong { color: #b2f0a2; }
#fps { color: #b2fac2; }
#cameraView { color: var(--gold); }

#status {
  top: 160px;
  left: 12px;
  display: flex;
  align-items: center;
  gap: 12px;
}

#mode { color: var(--gold); }

#riding {
  right: 12px;
  top: 12px;
  border-color: #f4cb77;
  color: #ffe2aa;
}

#crosshair {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font: 900 34px monospace;
}

#target {
  position: absolute;
  top: calc(50% + 30px);
  left: 50%;
  transform: translateX(-50%);
  font-size: 12px;
  font-weight: bold;
  white-space: nowrap;
}

#notice {
  position: absolute;
  top: 61%;
  left: 50%;
  transform: translateX(-50%);
  font-size: 16px;
  font-weight: bold;
  text-align: center;
  max-width: 92vw;
}

#bottom {
  position: absolute;
  bottom: 16px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7px;
}

#hotbar {
  display: flex;
  gap: 3px;
  padding: 5px;
  background: #111c1be9;
  border: 3px solid #a3b0a2;
}

.slot {
  width: 47px;
  height: 47px;
  display: grid;
  place-items: center;
  position: relative;
  background: #42594e;
  border: 2px solid #7b907e;
  font-size: 22px;
}

.slot.active {
  background: #789367;
  border: 3px solid white;
}

.slot.empty { opacity: .58; }

.slot small {
  position: absolute;
  bottom: 1px;
  right: 3px;
  font-size: 10px;
}

#heldName { font-size: 13px; }

/* INVENTORY */

#panel {
  position: fixed;
  z-index: 30;
  width: min(760px, 96vw);
  max-height: 88vh;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 18px;
  overflow-y: auto;
  border: 4px solid #8da99a;
  background: var(--panel);
  box-shadow: 0 18px 60px #000c;
}

#panel header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

#panel h2 {
  margin: 0;
  color: #c5eeac;
}

#panelHelp { color: #ccdccc; }

#entries {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.entry {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px;
  background: var(--surface);
  border: 1px solid #7e9486;
}

.entry .info { flex: 1; }

.entry strong,
.entry small { display: block; }

.entry small {
  margin-top: 5px;
  color: #d9e3db;
  line-height: 1.4;
}

.entry button { padding: 8px 12px; }

/* CLICKABLE FLY AND DISMOUNT BUTTONS */

#gameActions {
  position: absolute;
  right: 12px;
  top: 12px;
  z-index: 15;
  display: flex;
  flex-direction: column;
  gap: 8px;
  pointer-events: auto;
}

#gameActions button {
  min-width: 150px;
  padding: 12px;
  background: #375f81;
  border: 2px solid #bee5ff;
  color: white;
  font-weight: 900;
  box-shadow: 0 3px 12px #0009;
}

#gameActions #flyButton.enabled {
  background: #26884e;
  border-color: #a9ffc1;
}

#gameActions #dismountButton {
  background: #ae7837;
  border-color: #ffe7a6;
}

#gameActions #dismountButton[hidden] {
  display: none !important;
}

#flightInstructions {
  position: absolute;
  right: 12px;
  top: 70px;
  z-index: 10;
  max-width: 180px;
  padding: 8px;
  background: #07140ddd;
  border: 1px solid #bce9ff88;
  text-align: center;
  color: #d7f2ff;
  font: bold 11px/1.5 monospace;
  pointer-events: none;
}

#gameActions,
#flightInstructions {
  transition: opacity .15s ease;
}

@media (max-width: 600px) {
  #menu h1 { font-size: 36px; }
  #menu h2 { font-size: 13px; }

  .slot {
    width: 34px;
    height: 39px;
    font-size: 18px;
  }

  #hotbar { gap: 2px; padding: 3px; }

  #information {
    left: 7px;
    top: 7px;
    font-size: 10px;
  }

  #status {
    left: 7px;
    top: 143px;
    font-size: 10px;
  }

  #riding {
    top: auto;
    bottom: 107px;
  }

  #gameActions {
    top: 7px;
    right: 7px;
  }

  #gameActions button {
    min-width: 112px;
    padding: 9px;
    font-size: 11px;
  }

  #flightInstructions {
    top: 60px;
    right: 7px;
    font-size: 10px;
  }

  .entry { flex-wrap: wrap; }
  .entry .info { flex-basis: 100%; }
}
