
:root {
  --bg: #16252e;
  --green: #76a956;
  --border: #9ba7a1;
  --panel: #29373a;
  --text: #ffffff;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  user-select: none;
}

canvas {
  position: fixed;
  inset: 0;
  display: block;
  image-rendering: pixelated;
}

[hidden] {
  display: none !important;
}

button {
  appearance: none;
  border: 2px solid #314d33;
  background: var(--green);
  color: white;
  font: 800 14px Arial, sans-serif;
  padding: 12px 18px;
  cursor: pointer;
  box-shadow: inset 0 -3px #426b3a;
}

button:hover {
  filter: brightness(1.12);
}

button:disabled {
  cursor: default;
  opacity: .35;
}

.primary {
  min-width: 240px;
  background: #6bab4e;
}

.danger {
  min-width: 240px;
  background: #9d4d4d;
  border-color: #6a3434;
  box-shadow: inset 0 -3px #663636;
}

#menu {
  position: fixed;
  inset: 0;
  z-index: 20;
  background:
    radial-gradient(circle at 50% 35%, #315f53, transparent 55%),
    linear-gradient(135deg, #132333, #24422d);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 13px;
  padding: 24px;
  text-align: center;
  overflow: auto;
}

.brand {
  font-size: 23px;
  letter-spacing: 8px;
  font-weight: 900;
  color: #b8e4ff;
}

#menu h1 {
  font-size: clamp(34px, 7vw, 74px);
  color: #b6e48b;
  text-shadow: 5px 5px #25452c;
  margin: 0;
}

#menu > p {
  letter-spacing: 3px;
  color: #e0efdc;
}

.instructions {
  margin-top: 13px;
  width: min(600px, 95vw);
  background: #0005;
  border: 1px solid #879f8b;
  padding: 15px;
  line-height: 2;
}

.instructions strong {
  color: #f8df9a;
}

.instructions p {
  margin: 6px 0 0;
  font-size: 12px;
}

#hud {
  position: fixed;
  inset: 0;
  z-index: 5;
  pointer-events: none;
}

.top-left,
#status {
  position: absolute;
  left: 12px;
  padding: 10px 13px;
  background: #101716b8;
  border: 1px solid #ffffff50;
  text-shadow: 1px 1px 2px black;
  font-family: monospace;
  line-height: 1.7;
}

.top-left {
  top: 12px;
}

.game-name {
  color: #c1ecaa;
  font-weight: bold;
}

#status {
  top: 133px;
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}

#mode {
  color: #ffe7a1;
}

#crosshair {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font: bold 32px monospace;
  text-shadow:
    1px 1px 2px black,
    -1px -1px 2px black;
}

#notice {
  position: absolute;
  left: 50%;
  top: 60%;
  transform: translateX(-50%);
  font-size: 17px;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
  text-shadow: 2px 2px 3px black;
}

#bottom {
  position: absolute;
  left: 50%;
  bottom: 17px;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

#hotbar {
  background: #111b1be0;
  padding: 5px;
  border: 3px solid #8e9690;
  display: flex;
  gap: 3px;
}

.slot {
  width: 48px;
  height: 48px;
  background: #47534d;
  border: 2px solid #727e76;
  display: grid;
  place-items: center;
  position: relative;
  font-size: 24px;
}

.slot.active {
  background: #748d65;
  border: 3px solid white;
}

.slot small {
  position: absolute;
  bottom: 1px;
  right: 2px;
  font-size: 10px;
  text-shadow: 1px 1px black;
}

#itemName {
  font-weight: bold;
  text-shadow: 2px 2px 3px black;
}

#panel {
  position: fixed;
  z-index: 30;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: var(--panel);
  border: 4px solid var(--border);
  box-shadow: 0 15px 60px #000c;
  width: min(730px, 96vw);
  max-height: 87vh;
  padding: 19px;
  overflow-y: auto;
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

.panel-head h2 {
  margin: 0;
  color: #d8f0b7;
}

#panelHelp {
  color: #c1d3ca;
}

#panelItems {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.item-row {
  display: flex;
  align-items: center;
  gap: 9px;
  border: 1px solid #697d79;
  background: #3e4b49;
  padding: 10px;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-info strong,
.item-info small {
  display: block;
}

.item-info small {
  color: #c5d3cb;
  margin-top: 5px;
}

.item-row button {
  font-size: 12px;
  padding: 9px 12px;
}

@media (max-width: 600px) {
  .slot {
    width: 34px;
    height: 39px;
    font-size: 18px;
  }

  .top-left,
  #status {
    font-size: 11px;
  }

  #status {
    top: 126px;
    gap: 9px;
  }

  .item-row {
    flex-wrap: wrap;
  }

  .item-info {
    flex-basis: 100%;
  }
}
