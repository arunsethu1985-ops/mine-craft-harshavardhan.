*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden}body{background:#86c7f5;color:#fff;font-family:system-ui,Arial,sans-serif;user-select:none}[hidden]{display:none!important}canvas{display:block;position:fixed;inset:0;width:100%;height:100%}button{font:700 14px system-ui;cursor:pointer;padding:10px 15px;color:#fff;background:#238449;border:2px solid #a6ffb8;border-radius:5px}button:hover{filter:brightness(1.15)}button:disabled{opacity:.45;cursor:default}.overlay{position:fixed;inset:0;z-index:100;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:24px;background:linear-gradient(145deg,#091729,#184767,#245b36)}#menu h1{margin:0;color:#98ff9f;font-size:clamp(30px,5vw,62px);text-shadow:0 4px #1e5128,0 0 22px #36c85b}#menu h2{font-size:clamp(13px,2vw,20px);letter-spacing:2px;color:#d2edff}#menu #play{font-size:24px;padding:15px 45px;margin:15px}#menu #reset{font-size:12px;background:#813b3b}#menu p{line-height:1.9;color:#dcebf4;font-size:13px;max-width:780px}#hud{position:fixed;inset:0;pointer-events:none;z-index:10}#top{position:fixed;inset:0 0 auto 0;padding:12px 16px;display:flex;justify-content:space-between;gap:15px;background:#000a;font-size:13px}#coords{font-family:monospace;color:#b0ffc2}#stats{position:fixed;top:61px;left:14px;padding:14px;background:#0009;border:1px solid #ffffff40;border-radius:6px;font-size:13px;line-height:2}#weapon{color:#bff9ff}#crosshair{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);font:700 31px monospace;text-shadow:1px 1px 3px #000}#notice{position:fixed;left:0;top:24%;width:100%;text-align:center;font-weight:700;color:#fff195;text-shadow:1px 2px 4px #000}#bottom{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px;white-space:nowrap;text-shadow:1px 1px 3px #000}#hotbar{display:flex;gap:3px;padding:5px;background:#000b;border:3px solid #444}.slot{height:52px;width:52px;background:#525252;border:3px solid #777;display:flex;align-items:center;justify-content:center;font-size:24px;position:relative}.slot.active{border-color:#ffe87d;background:#999}.slot small{position:absolute;bottom:1px;right:3px;font-size:10px}#bottom small{font-size:11px}#panel{position:fixed;z-index:250;top:50%;left:50%;transform:translate(-50%,-50%);width:min(610px,95vw);max-height:85vh;overflow:auto;padding:20px;background:#283640;border:4px solid #8b9ea6;border-radius:8px;box-shadow:0 12px 55px #000b;text-align:center}#panel h2{margin:2px 0 8px;color:#aaffbc}#panelHelp{font-size:12px;color:#d2dce0;line-height:1.5}.entry{display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:left;background:#3c4e59;border:1px solid #576772;padding:9px;margin:6px 0;border-radius:5px}.entry .info{flex:1}.entry small{display:block;color:#d5e0e4}.entry button{font-size:11px;padding:6px 9px;margin-left:3px}#closePanel{margin-top:15px}@media(max-width:600px){#top{font-size:10px}#stats{font-size:11px;padding:8px}.slot{width:35px;height:41px;font-size:17px}#bottom small{font-size:9px}#menu p{font-size:11px}}
