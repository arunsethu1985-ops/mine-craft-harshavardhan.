
/* =========================================
   GALAXY BLOCKVERSE
   COMPLETE GAME STYLESHEET
   ========================================= */

/* GLOBAL */

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

body {
  background: #152333;
  color: #ffffff;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 14px;
  user-select: none;
}

canvas {
  display: block;
  image-rendering: pixelated;
}

[hidden] {
  display: none !important;
}

/* BUTTONS */

button {
  background: #619e48;
  color: white;
  border: 2px solid #314b2d;
  padding: 11px 16px;
  font-size: 14px;
  font-family: Arial, sans-serif;
  font-weight: bold;
  cursor: pointer;
  transition: filter 0.15s ease;
}

button:hover {
  filter: brightness(1.12);
}

button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.danger {
  background: #a34b4b;
  border-color: #693434;
}

/* MAIN MENU */

#menu {
  position: fixed;
  inset: 0;
  z-index: 10;

  background: linear-gradient(
    135deg,
    #15283af5,
    #255139f5
  );

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;
  gap: 14px;
  padding: 20px;
  overflow-y: auto;
}

#menu h1 {
  font-size: clamp(32px, 6vw, 64px);
  color: #a9ed83;
  text-shadow: 4px 4px #29422b;
  margin: 0;
}

#menu h2 {
  margin: 0;
  color: #ffe1a1;
  letter-spacing: 4px;
}

#menu p {
  line-height: 2;
  max-width: 750px;
}

/* HUD */

#hud {
  position: fixed;
  inset: 0;
  pointer-events: none;
}

/* GAME INFORMATION */

#top,
#stats {
  position: absolute;
  left: 12px;
  background: #000a;
  padding: 11px;
  border: 1px solid #ffffff55;
}

#top {
  top: 12px;
  line-height: 1.7;
}

#stats {
  top: 115px;
}

#fps {
  color: #a9ed83;
  font-weight: 700;
}

/* CROSSHAIR */

#crosshair {
  position: absolute;
  left: 50%;
  top: 50%;

  transform: translate(-50%, -50%);

  font-family: monospace;
  font-size: 32px;
  font-weight: bold;
  color: white;

  text-shadow:
    1px 1px 4px black,
    -1px -1px 4px black;
}

/* GAME NOTIFICATIONS */

#notice {
  position: absolute;
  top: 59%;
  left: 50%;

  transform: translateX(-50%);

  text-align: center;
  font-weight: bold;
  color: white;

  text-shadow: 2px 2px 3px black;
}

/* HOTBAR AREA */

#bottom {
  position: absolute;
  left: 50%;
  bottom: 16px;

  transform: translateX(-50%);
  text-align: center;
}

#hotbar {
  display: flex;
  gap: 3px;

  padding: 5px;
  background: #101010cc;
  border: 3px solid #999999;
}

/* INDIVIDUAL INVENTORY SLOTS */

.slot {
  height: 47px;
  width: 47px;

  background: #394349;
  border: 2px solid #747979;

  display: grid;
  place-items: center;

  position: relative;
  font-size: 23px;
}

.slot.active {
  border: 3px solid white;
  background: #637b60;
}

.slot small {
  position: absolute;
  bottom: 1px;
  right: 3px;

  font-size: 10px;
  color: white;
}

/* SELECTED ITEM LABEL */

#selection {
  display: block;
  margin-top: 7px;
  text-shadow: 1px 2px black;
}

/* INVENTORY / CRAFTING PANEL */

#panel {
  position: fixed;
  z-index: 15;

  top: 50%;
  left: 50%;

  transform: translate(-50%, -50%);

  width: min(700px, 95vw);
  max-height: 86vh;

  overflow-y: auto;

  background: #2b3438;
  border: 4px solid #829390;

  padding: 18px;

  box-shadow: 0 15px 60px #000b;
}

/* PANEL HEADER */

#panel header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

#panel h2 {
  margin: 0;
  color: #c5e7a9;
}

/* PANEL HELP TEXT */

#help {
  color: #bfd0c5;
  line-height: 1.5;
}

/* INVENTORY ENTRIES */

#entries {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.entry {
  display: flex;
  align-items: center;
  gap: 8px;

  background: #424c4e;
  padding: 9px;
  border: 1px solid #657475;
}

.entry .info {
  flex: 1;
}

.entry strong,
.entry small {
  display: block;
}

.entry small {
  margin-top: 4px;
  color: #c4d0cc;
}

/* RESPONSIVE SMALL SCREEN */

@media (max-width: 550px) {
  .slot {
    width: 34px;
    height: 38px;
    font-size: 18px;
  }

  #top,
  #stats {
    font-size: 11px;
  }

  .entry {
    flex-wrap: wrap;
  }

  .entry .info {
    flex-basis: 100%;
  }

  #panel header {
    flex-wrap: wrap;
  }

  #menu h1 {
    font-size: 34px;
  }
}
